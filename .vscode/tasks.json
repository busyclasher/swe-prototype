{
  "version": "2.0.0",
  "options": {
    "env": { "PATH": "C:\\Program Files\\nodejs;${env:PATH}" }
  },
  "tasks": [
    {
      "label": "Sonara: install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Sonara: dev server",
      "type": "shell",
      "command": "npx vite --port 5173",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "activesBegin": true, "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    },
    {
      "label": "Sonara: unit tests",
      "type": "shell",
      "command": "npm test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Sonara: build",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": []
    },
    {
      "label": "Sonara: end-to-end + screenshots",
      "type": "shell",
      "command": "npm run build; npm run screenshots",
      "problemMatcher": []
    }
  ]
}
